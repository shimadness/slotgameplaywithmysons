# App Store Connect APIキーの情報。実物は asc-key.env（git管理外）に置く。
# 作り方: App Store Connect → ユーザとアクセス → 統合 → App Store Connect API
#         → キーを生成（ロール: App Manager）→ .p8 をダウンロード
ASC_KEY_ID=ABC123DEFG
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_PATH=$HOME/.appstoreconnect/private_keys/AuthKey_ABC123DEFG.p8
